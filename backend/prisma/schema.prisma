generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MUSICIAN
  BAND
  VENUE
  PROMOTER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile          Profile?
  bookingsAsRenter Booking[]                 @relation("RenterBookings")
  sentMessages     Message[]                 @relation("SentMessages")
  participants     ConversationParticipant[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  displayName String   @map("display_name")
  bio         String?
  city        String
  country     String   @default("ES")
  avatarUrl   String?  @map("avatar_url")
  genres      String[]
  socialLinks Json?    @map("social_links")
  isPremium   Boolean  @default(false) @map("is_premium")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    Media[]
  musician Musician?
  band     Band?
  venue    Venue?
  promoter Promoter?

  @@map("profiles")
}

model Musician {
  id              String   @id @default(cuid())
  profileId       String   @unique @map("profile_id")
  instruments     String[]
  yearsExperience Int?     @map("years_experience")
  lookingForBand  Boolean  @default(false) @map("looking_for_band")
  openToCollabs   Boolean  @default(true) @map("open_to_collabs")

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bandMembers BandMember[]

  @@map("musicians")
}

model Band {
  id                String    @id @default(cuid())
  profileId         String    @unique @map("profile_id")
  lookingForMembers Boolean   @default(false) @map("looking_for_members")
  wantedRoles       String[]  @map("wanted_roles")
  formedAt          DateTime? @map("formed_at")

  profile  Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  members  BandMember[]
  bookings Booking[]    @relation("BandBookings")

  @@map("bands")
}

model BandMember {
  id         String   @id @default(cuid())
  bandId     String   @map("band_id")
  musicianId String   @map("musician_id")
  role       String
  joinedAt   DateTime @default(now()) @map("joined_at")

  band     Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  musician Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@unique([bandId, musicianId])
  @@map("band_members")
}

model Venue {
  id         String  @id @default(cuid())
  profileId  String  @unique @map("profile_id")
  capacity   Int?
  hourlyRate Decimal @map("hourly_rate") @db.Decimal(10, 2)
  currency   String  @default("EUR")
  amenities  String[]
  address    String
  latitude   Float?
  longitude  Float?

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rooms    Room[]
  bookings Booking[] @relation("VenueBookings")

  @@map("venues")
}

model Room {
  id          String  @id @default(cuid())
  venueId     String  @map("venue_id")
  name        String
  capacity    Int?
  hourlyRate  Decimal @map("hourly_rate") @db.Decimal(10, 2)
  description String?
  amenities   String[]

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("rooms")
}

model Promoter {
  id         String   @id @default(cuid())
  profileId  String   @unique @map("profile_id")
  eventTypes String[] @map("event_types")
  website    String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("promoters")
}

model Booking {
  id              String        @id @default(cuid())
  venueId         String        @map("venue_id")
  roomId          String?       @map("room_id")
  bandId          String?       @map("band_id")
  renterId        String        @map("renter_id")
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  status          BookingStatus @default(PENDING)
  totalPrice      Decimal       @map("total_price") @db.Decimal(10, 2)
  platformFee     Decimal       @map("platform_fee") @db.Decimal(10, 2)
  stripePaymentId String?       @map("stripe_payment_id")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  venue  Venue  @relation("VenueBookings", fields: [venueId], references: [id])
  room   Room?  @relation(fields: [roomId], references: [id])
  band   Band?  @relation("BandBookings", fields: [bandId], references: [id])
  renter User   @relation("RenterBookings", fields: [renterId], references: [id])

  @@map("bookings")
}

model Media {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id")
  type      MediaType
  url       String
  publicId  String    @map("public_id")
  title     String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("media")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @map("conversation_id")
  userId         String @map("user_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}
